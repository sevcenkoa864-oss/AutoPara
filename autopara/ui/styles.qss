/* AutoPara — Apple-style interface. See docs/FRONTEND.md.
 *
 * This is a TEMPLATE, not a finished stylesheet: every colour is a dollar-prefixed token that
 * core/theme.py substitutes from the light or dark palette. Never hard-code a colour here — a
 * literal would look right in one theme and wrong in the other.
 *
 * Shape and spacing follow Apple's Human Interface Guidelines as far as Qt allows. What Qt does
 * NOT allow, and which therefore lives in Python instead: shadows (QGraphicsDropShadowEffect in
 * class_card.py), letter spacing, transitions, and any kind of backdrop blur. Radii are concentric
 * — a control nested in a container gets a smaller radius than the container, or the curves clash. */

QWidget {
    background: $bg;
    color: $text;
    /* One resolved family, not a fallback list: Qt honours only the first name in a QSS
     * font-family, so the choice is made in core/theme.interface_font() instead. */
    font-family: $font_family;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background: $bg;
}

/* The blanket QWidget rule above gives every label an opaque background, which paints a block of
 * the window colour over whatever the label sits on. Invisible while the two colours agree, and a
 * grey rectangle across every card the moment they do not. Labels take their surroundings. */
QLabel {
    background: transparent;
}

/* ------------------------------------------------------------------ sidebar */

/* The window's actions live in a column on the left. The week grid is wide and short, so a strip
 * across the top spent the height the calendar wants and left the width it does not need. */
#Sidebar {
    background: $sunken;
    border-right: 1px solid $border_soft;
}

/* Dialogs still have a heading; the main window shows the app mark instead of its own name. */
#TitleLabel {
    font-size: 13pt;
    font-weight: 600;
    color: $text;
}

#SubtitleLabel {
    color: $text_muted;
    font-size: 9pt;
}

/* ------------------------------------------------------------------ buttons */

/* The secondary tier: a soft fill instead of an outline. Apple separates controls from their
 * surroundings with fill and space, not with a box drawn around every one of them. */
QPushButton {
    background: $sunken;
    border: none;
    border-radius: 8px;
    padding: 7px 14px;
    color: $text;
    font-weight: 500;
}

QPushButton:hover {
    background: $chip_bg;
    color: $accent_ink;
}

QPushButton:pressed {
    background: $border_soft;
}

QPushButton:disabled {
    color: $text_faint;
    background: $sunken;
}

/* The prominent tier: exactly one per screen. A pill, because a standalone primary action is
 * fully rounded in the current design language. min-height plus padding make the height 34, so
 * the radius is exactly half of it. */
QPushButton#Primary {
    background: $accent_fill;
    color: $accent_text;
    font-weight: 600;
    min-height: 18px;
    padding: 8px 20px;
    border-radius: 17px;
}

QPushButton#Primary:hover {
    background: $accent_hover;
    color: $accent_text;
}

QPushButton#Primary:pressed {
    background: $accent_hover;
}

QPushButton#Primary:disabled {
    background: $sunken;
    color: $text_faint;
}

/* The plain tier: no fill at all, for the action that is offered but not encouraged. */
QPushButton#Plain {
    background: transparent;
    color: $accent_ink;
    font-weight: 500;
    padding: 8px 12px;
}

QPushButton#Plain:hover {
    background: $accent_soft;
}

QPushButton#Plain:disabled {
    background: transparent;
    color: $text_faint;
}

/* The one prominent action, reduced to a circle. There is no room for a label on a rail this
 * narrow, and a pill with nothing written on it is just a circle that has been stretched. */
QPushButton#PrimaryRound {
    background: $accent_fill;
    border: none;
    border-radius: 20px;
    padding: 0;
}

QPushButton#PrimaryRound:hover {
    background: $accent_hover;
}

QPushButton#PrimaryRound:pressed {
    background: $accent_hover;
}

/* Icon-only rail buttons. Sized in Python (36x36); the meaning is in the tooltip. */
QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
}

QPushButton#IconButton:hover {
    background: $chip_bg;
}

QPushButton#IconButton:pressed {
    background: $chip_bg;
}

/* --------------------------------------------------------------- week grid */

/* Hairlines, not a spreadsheet: the day rule is the palette's faintest line and the hour rule
 * only slightly stronger, so the grid guides the eye without competing with the cards on it. */

#GridScroll {
    border: none;
}

#DayHeader {
    background: $surface;
    border-bottom: 1px solid $border;
}

#DayHeader[today="true"] {
    background: $today_bg;
}

#DayName {
    color: $text_muted;
    font-size: 9pt;
    font-weight: 600;
}

#DayName[today="true"] {
    color: $accent_ink;
}

#TimeGutter {
    background: $surface;
    border-right: 1px solid $border_soft;
}

#HourLabel {
    color: $text_faint;
    font-size: 8.5pt;
    font-weight: 500;
}

#GridCell {
    background: $surface;
    border-right: 1px solid $grid_line;
    border-bottom: 1px solid $grid_line;
}

#GridCell[today="true"] {
    background: $today_bg;
}

#GridCell[now="true"] {
    background: $now_bg;
}

#GridCell:hover {
    background: $sunken;
}

#GridCell[dropping="true"] {
    background: $drop_bg;
    border: 2px dashed $accent;
    border-radius: 10px;
}

/* -------------------------------------------------------------- class card */

#ClassCard {
    background: $card_bg;
    border: 1px solid $border_soft;
    border-left: 4px solid $accent;
    border-radius: 12px;
}

#ClassCard:hover {
    border-color: $accent;
}

#ClassCard[state="opened"] {
    background: $opened_bg;
}

#ClassCard[state="missed"] {
    border-left-color: $danger;
    background: $missed_bg;
}

#ClassCard[state="skipped"] {
    background: $skipped_bg;
    border-style: dashed;
}

#ClassCard[state="next"] {
    border: 2px solid $accent;
    border-left: 4px solid $accent;
}

#ClassCard[state="nolink"] {
    border-style: dashed;
    background: $nolink_bg;
}

#CardSubject {
    font-weight: 600;
    font-size: 9.5pt;
    color: $text;
}

#CardSubject[muted="true"] {
    color: $text_muted;
}

#CardTeacher {
    color: $text_muted;
    font-size: 8pt;
}

#CardTime {
    color: $text_muted;
    font-size: 8pt;
}

/* Badges are capsules: a short label on a coloured fill is a pill in this language, never a
 * rounded rectangle. */
#CardBadge {
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 8pt;
    font-weight: 600;
}

#CardBadge[provider="zoom"] {
    background: $zoom_bg;
    color: $zoom_fg;
}

#CardBadge[provider="google_meet"] {
    background: $meet_bg;
    color: $meet_fg;
}

#CardBadge[provider="unknown"] {
    background: $chip_bg;
    color: $text_muted;
}

#StateBadge {
    font-size: 8pt;
    font-weight: 600;
    border-radius: 8px;
    padding: 2px 7px;
}

#StateBadge[state="opened"] {
    background: $success_bg;
    color: $success_fg;
}

#StateBadge[state="missed"] {
    background: $danger_bg;
    color: $danger_fg;
}

#StateBadge[state="skipped"] {
    background: $chip_bg;
    color: $text_muted;
}

#StateBadge[state="nolink"] {
    background: $warn_bg;
    color: $warn_fg;
}

#GroupChip {
    background: $chip_bg;
    color: $text_muted;
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 8pt;
}

/* --------------------------------------------------------- missed-class bar */

#CatchupBanner {
    background: $banner_bg;
    border-bottom: 1px solid $banner_border;
}

#CatchupText {
    color: $banner_text;
    font-size: 10pt;
    font-weight: 600;
}

#CatchupDetail {
    color: $banner_text;
    font-size: 9pt;
}

/* ---------------------------------------------------------- import landing */

/* The first screen of a fresh install: a hero, and a well a .docx can be dropped into. */

#HeroPlate {
    background: $hero_bg;
    border-radius: 22px;
}

#HeroTitle {
    font-size: 22pt;
    font-weight: 600;
    color: $text;
}

#DropWell {
    background: $surface;
    border: 2px dashed $drop_border;
    border-radius: 14px;
}

#DropWell[hover="true"] {
    background: $drop_hover_bg;
    border-color: $accent;
}

#DropWellText {
    color: $text_muted;
    font-size: 10pt;
}

#DropWellText[hover="true"] {
    color: $accent_ink;
    font-weight: 500;
}

#DropWellFile {
    color: $text;
    font-size: 10pt;
    font-weight: 600;
}

/* ------------------------------------------------------------------ dialogs */

QLineEdit, QComboBox, QSpinBox, QTimeEdit {
    border: 1px solid $border;
    border-radius: 8px;
    padding: 7px 10px;
    background: $surface;
    color: $text;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTimeEdit:focus {
    border-color: $accent;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

/* Styling any part of a sub-control stops Qt drawing the native one, so the arrows have to be
 * supplied. They are painted per theme by core/theme.chevron_icon, like the checkbox tick. */
QComboBox::down-arrow {
    image: $chevron_down;
    width: 14px;
    height: 9px;
}

QSpinBox::up-button, QTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    background: transparent;
}

QSpinBox::down-button, QTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow, QTimeEdit::up-arrow {
    image: $chevron_up;
    width: 14px;
    height: 9px;
}

QSpinBox::down-arrow, QTimeEdit::down-arrow {
    image: $chevron_down;
    width: 14px;
    height: 9px;
}

QComboBox QAbstractItemView {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: $accent_soft;
    selection-color: $accent_ink;
}

/* A grouped list: one recessed, rounded container whose rows are told apart by space and a tinted
 * selection rather than by a rule drawn around each of them. */
QListWidget {
    background: $sunken;
    border: none;
    border-radius: 10px;
    padding: 4px;
}

QListWidget::item {
    padding: 9px 10px;
    border-radius: 7px;
    color: $text;
}

QListWidget::item:hover {
    background: $chip_bg;
}

QListWidget::item:selected {
    background: $accent_soft;
    color: $accent_ink;
}

/* A section of a settings-style form: the same recessed container, filled from Python. */
#GroupBox {
    background: $sunken;
    border: none;
    border-radius: 10px;
}

#Separator {
    background: $border_soft;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* Indicators must be styled for EVERY state once any rule touches the widget: as soon as a
 * stylesheet applies to a QCheckBox or QRadioButton, Qt stops drawing the native indicator and
 * paints only what the stylesheet asks for. Styling just `spacing` left the checked radio button
 * with no indicator at all -- the selected option looked like plain text. */

QCheckBox {
    spacing: 10px;
    background: transparent;
}

QRadioButton {
    spacing: 10px;
    padding: 3px 0;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 2px solid $border;
    background: $surface;
}

QCheckBox::indicator {
    border-radius: 5px;
}

QRadioButton::indicator {
    /* Half of width + both borders, so the box is a circle rather than a rounded square. */
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: $accent;
}

/* The dot and the tick are drawn with gradients rather than images: the box size stays identical
 * between states, so checking an option cannot shift the row it sits in. */
QRadioButton::indicator:checked {
    border-color: $accent;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
                                stop: 0 $accent, stop: 0.55 $accent,
                                stop: 0.6 $surface, stop: 1 $surface);
}

/* A tick, not a coloured block: the box keeps its background and gets a drawn checkmark,
 * generated per theme by core/theme.checkmark_icon (QSS cannot draw a shape itself). */
QCheckBox::indicator:checked {
    border-color: $accent;
    background: $surface;
    image: $check_icon;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: $border_soft;
    background: $sunken;
}

/* Popup menus keep square outer corners: a rounded QMenu shows the desktop through its corners on
 * Windows unless the popup is made translucent, which costs more than the curve is worth. */
QMenu {
    background: $surface;
    border: 1px solid $border;
    padding: 5px;
}

QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 7px;
}

QMenu::item:selected {
    background: $accent_soft;
    color: $accent_ink;
}

QMenu::separator {
    height: 1px;
    background: $border_soft;
    margin: 5px 8px;
}

#FormHint {
    color: $text_muted;
    font-size: 9pt;
}

#SectionLabel {
    font-weight: 600;
    font-size: 9pt;
    color: $text_muted;
    padding-top: 8px;
}

#EmptyState {
    color: $text_muted;
    font-size: 10pt;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: $scroll;
    border-radius: 4px;
    min-height: 32px;
    margin: 2px 4px 2px 4px;
}

QScrollBar::handle:vertical:hover {
    background: $scroll_hover;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background: $scroll;
    border-radius: 4px;
    min-width: 32px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:horizontal:hover {
    background: $scroll_hover;
}

QToolTip {
    background: $tooltip_bg;
    color: $tooltip_fg;
    border: none;
    padding: 6px 9px;
    border-radius: 7px;
}
