/* AutoPara — calendar-like styling. See docs/FRONTEND.md.
 *
 * This is a TEMPLATE, not a finished stylesheet: every colour is a dollar-prefixed token that
 * core/theme.py substitutes from the light or dark palette. Never hard-code a colour here — a
 * literal would look right in one theme and wrong in the other.
 *
 * Authorised by MaBoRo (Vladyslav Tishyn), vlad.tishyn@gmail.com */

QWidget {
    background: $bg;
    color: $text;
    font-family: "Segoe UI", "Segoe UI Variable", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background: $bg;
}

/* ------------------------------------------------------------------ toolbar */

#Toolbar {
    background: $surface;
    border-bottom: 1px solid $border_soft;
}

#TitleLabel {
    font-size: 15pt;
    font-weight: 600;
    color: $text;
}

#SubtitleLabel {
    color: $text_muted;
    font-size: 9pt;
}

QPushButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 6px 14px;
    color: $text;
}

QPushButton:hover {
    background: $sunken;
    border-color: $accent;
}

QPushButton:pressed {
    background: $sunken;
}

QPushButton:disabled {
    color: $text_faint;
    border-color: $border_soft;
}

QPushButton#Primary {
    background: $accent;
    border-color: $accent;
    color: $accent_text;
    font-weight: 600;
}

QPushButton#Primary:hover {
    background: $accent_hover;
}

QPushButton#IconButton {
    padding: 5px 10px;
    font-size: 11pt;
}

/* --------------------------------------------------------------- week grid */

#GridScroll {
    border: none;
}

#DayHeader {
    background: $surface;
    border-bottom: 1px solid $border_soft;
    border-right: 1px solid $grid_line;
}

#DayHeader[today="true"] {
    background: $accent_soft;
}

#DayName {
    color: $text_muted;
    font-size: 8.5pt;
    font-weight: 600;
}

#DayName[today="true"] {
    color: $accent;
}

#TimeGutter {
    background: $surface;
    border-right: 1px solid $border_soft;
}

#HourLabel {
    color: $text_muted;
    font-size: 8.5pt;
    font-weight: 600;
}

#GridCell {
    background: $surface;
    border-right: 1px solid $grid_line;
    border-bottom: 1px solid $grid_line;
}

#GridCell[today="true"] {
    background: $today_bg;
}

#GridCell[now="true"] {
    background: $now_bg;
}

#GridCell:hover {
    background: $sunken;
}

#GridCell[dropping="true"] {
    background: $drop_bg;
    border: 1px dashed $accent;
}

#CellHint {
    color: $text_faint;
    font-size: 8.5pt;
}

/* -------------------------------------------------------------- class card */

#ClassCard {
    background: $card_bg;
    border: 1px solid $border;
    border-left: 4px solid $accent;
    border-radius: 8px;
}

#ClassCard:hover {
    border-color: $accent;
}

#ClassCard[state="opened"] {
    background: $opened_bg;
}

#ClassCard[state="missed"] {
    border-left-color: $danger;
    background: $missed_bg;
}

#ClassCard[state="skipped"] {
    background: $skipped_bg;
    border-style: dashed;
}

#ClassCard[state="next"] {
    border: 2px solid $accent;
    border-left: 4px solid $accent;
}

#ClassCard[state="nolink"] {
    border-style: dashed;
    background: $nolink_bg;
}

#CardSubject {
    font-weight: 600;
    font-size: 9.5pt;
    color: $text;
}

#CardSubject[muted="true"] {
    color: $text_faint;
}

#CardTeacher {
    color: $text_muted;
    font-size: 8pt;
}

#CardTime {
    color: $text_muted;
    font-size: 8pt;
}

#CardBadge {
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 7.5pt;
    font-weight: 600;
}

#CardBadge[provider="zoom"] {
    background: $zoom_bg;
    color: $zoom_fg;
}

#CardBadge[provider="google_meet"] {
    background: $meet_bg;
    color: $meet_fg;
}

#CardBadge[provider="unknown"] {
    background: $chip_bg;
    color: $text_muted;
}

#StateBadge {
    font-size: 7.5pt;
    font-weight: 600;
    border-radius: 4px;
    padding: 1px 6px;
}

#StateBadge[state="opened"] {
    background: $success_bg;
    color: $success_fg;
}

#StateBadge[state="missed"] {
    background: $danger_bg;
    color: $danger_fg;
}

#StateBadge[state="skipped"] {
    background: $chip_bg;
    color: $text_muted;
}

#StateBadge[state="nolink"] {
    background: $warn_bg;
    color: $warn_fg;
}

#GroupChip {
    background: $chip_bg;
    color: $text_muted;
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 7.5pt;
}

/* --------------------------------------------------------- missed-class bar */

#CatchupBanner {
    background: $banner_bg;
    border-bottom: 1px solid $banner_border;
}

#CatchupText {
    color: $banner_text;
    font-size: 9.5pt;
    font-weight: 600;
}

#CatchupDetail {
    color: $banner_text;
    font-size: 8.5pt;
}

/* ------------------------------------------------------------------ dialogs */

QLineEdit, QComboBox, QSpinBox, QTimeEdit {
    border: 1px solid $border;
    border-radius: 6px;
    padding: 6px 8px;
    background: $surface;
    color: $text;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTimeEdit:focus {
    border-color: $accent;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    selection-background-color: $accent_soft;
    selection-color: $text;
}

QListWidget {
    border: 1px solid $border;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item {
    padding: 7px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background: $accent_soft;
    color: $accent;
}

/* Indicators must be styled for EVERY state once any rule touches the widget: as soon as a
 * stylesheet applies to a QCheckBox or QRadioButton, Qt stops drawing the native indicator and
 * paints only what the stylesheet asks for. Styling just `spacing` left the checked radio button
 * with no indicator at all -- the selected option looked like plain text. */

QCheckBox {
    spacing: 8px;
}

QRadioButton {
    spacing: 8px;
    padding: 2px 0;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 2px solid $border;
    background: $surface;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    /* Half of width + both borders, so the box is a circle rather than a rounded square. */
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: $accent;
}

/* The dot and the tick are drawn with gradients rather than images: the box size stays identical
 * between states, so checking an option cannot shift the row it sits in. */
QRadioButton::indicator:checked {
    border-color: $accent;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
                                stop: 0 $accent, stop: 0.55 $accent,
                                stop: 0.6 $surface, stop: 1 $surface);
}

/* A tick, not a coloured block: the box keeps its background and gets a drawn checkmark,
 * generated per theme by core/theme.checkmark_icon (QSS cannot draw a shape itself). */
QCheckBox::indicator:checked {
    border-color: $accent;
    background: $surface;
    image: $check_icon;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: $border_soft;
    background: $sunken;
}

QMenu {
    background: $surface;
    border: 1px solid $border;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px 6px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: $accent_soft;
    color: $accent;
}

QMenu::separator {
    height: 1px;
    background: $border_soft;
    margin: 4px 8px;
}

#FormHint {
    color: $text_muted;
    font-size: 8.5pt;
}

#SectionLabel {
    font-weight: 600;
    color: $text;
    padding-top: 6px;
}

#EmptyState {
    color: $text_faint;
    font-size: 11pt;
}

#StatusBar {
    background: $surface;
    border-top: 1px solid $border_soft;
    color: $text_muted;
    font-size: 8.5pt;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: $scroll;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: $scroll_hover;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: $scroll;
    border-radius: 5px;
    min-width: 30px;
}

QToolTip {
    background: $tooltip_bg;
    color: $tooltip_fg;
    border: none;
    padding: 5px 8px;
    border-radius: 4px;
}
